<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-feature
            android:name="android.software.live_wallpaper"
            android:required="false" />

    <application
            android:name=".ChronoApplication"
            android:allowBackup="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@style/Theme.ChronoPaper">

        <activity
                android:name=".MainActivity"
                android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity-alias
                android:name=".WallpaperSettingsActivity"
                android:targetActivity=".MainActivity"
                android:exported="true" />

        <service
                android:name=".service.ChronoWallpaperService"
                android:exported="true"
                android:label="@string/wallpaper_service_label"
                android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                    android:name="android.service.wallpaper"
                    android:resource="@xml/chrono_wallpaper" />
        </service>
    </application>

</manifest>